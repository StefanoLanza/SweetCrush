index 000000000..ebd74cf72
--- /dev/null
+++ b/src/video/ohos/SDL_ohosmouse.c
@@ -0,0 +1,162 @@
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_OHOS
+
+#include "SDL_ohosmouse.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../core/ohos/SDL_ohos.h"
+
+struct SDL_CursorData
+{
+    int custom_cursor;
+    int system_cursor;
+};
+
+// Last known OHOS mouse button state (includes all buttons)
+static int last_state;
+
+// Blank cursor
+static SDL_Cursor *empty_cursor;
+
+static SDL_Cursor *OHOS_WrapCursor(int custom_cursor, int system_cursor)
+{
+    SDL_Cursor *cursor = SDL_calloc(1, sizeof(*cursor));
+    if (cursor) {
+        SDL_CursorData *data = (SDL_CursorData *)SDL_calloc(1, sizeof(*data));
+        if (data) {
+            data->custom_cursor = custom_cursor;
+            data->system_cursor = system_cursor;
+            cursor->internal = data;
+        } else {
+            SDL_free(cursor);
+            cursor = NULL;
+        }
+    }
+
+    return cursor;
+}
+
+static SDL_Cursor *OHOS_CreateDefaultCursor(void)
+{
+    SDL_SystemCursor id = SDL_GetDefaultSystemCursor();
+    return OHOS_WrapCursor(0, id);
+}
+
+static SDL_Cursor *OHOS_CreateCursor(SDL_Surface *surface, int hot_x, int hot_y)
+{
+    int custom_cursor;
+    SDL_Surface *converted;
+
+    converted = SDL_ConvertSurface(surface, SDL_PIXELFORMAT_ARGB8888);
+    if (!converted) {
+        return NULL;
+    }
+    custom_cursor = 0; //TODO Android_JNI_CreateCustomCursor(converted, hot_x, hot_y);
+    SDL_DestroySurface(converted);
+    if (!custom_cursor) {
+        SDL_Unsupported();
+        return NULL;
+    }
+    return OHOS_WrapCursor(custom_cursor, 0);
+}
+
+static SDL_Cursor *OHOS_CreateSystemCursor(SDL_SystemCursor id)
+{
+    return OHOS_WrapCursor(0, id);
+}
+
+static void OHOS_FreeCursor(SDL_Cursor *cursor)
+{
+    SDL_CursorData *data = cursor->internal;
+    if (data->custom_cursor != 0) {
+        OHOS_TS_DestroyCustomCursor(data->custom_cursor);
+    }
+    SDL_free(cursor->internal);
+    SDL_free(cursor);
+}
+
+static SDL_Cursor *OHOS_CreateEmptyCursor(void)
+{
+    if (!empty_cursor) {
+        SDL_Surface *empty_surface = SDL_CreateSurface(1, 1, SDL_PIXELFORMAT_ARGB8888);
+        if (empty_surface) {
+            SDL_memset(empty_surface->pixels, 0, (size_t)empty_surface->h * empty_surface->pitch);
+            empty_cursor = OHOS_CreateCursor(empty_surface, 0, 0);
+            SDL_DestroySurface(empty_surface);
+        }
+    }
+    return empty_cursor;
+}
+
+static void OHOS_DestroyEmptyCursor(void)
+{
+    if (empty_cursor) {
+        OHOS_FreeCursor(empty_cursor);
+        empty_cursor = NULL;
+    }
+}
+
+static bool OHOS_ShowCursor(SDL_Cursor *cursor)
+{
+    if (!cursor) {
+        cursor = OHOS_CreateEmptyCursor();
+    }
+    if (cursor) {
+        SDL_CursorData *data = cursor->internal;
+        if (data->custom_cursor) {
+            if (!OHOS_TS_SetCustomCursor(data->custom_cursor)) {
+                return SDL_Unsupported();
+            }
+        } else {
+            if (!OHOS_TS_SetCustomCursor(data->system_cursor)) {
+                return SDL_Unsupported();
+            }
+        }
+        return true;
+    } else {
+        // SDL error set inside OHOS_CreateEmptyCursor()
+        return false;
+    }
+}
+
+static bool OHOS_SetRelativeMouseMode(bool enabled)
+{
+    if (!OHOS_TS_SupportsRelativeMouse()) {
+        return SDL_Unsupported();
+    }
+
+    if (!OHOS_TS_SetRelativeMouseEnabled(enabled)) {
+        return SDL_Unsupported();
+    }
+
+    return true;
+}
+
+void OHOS_InitMouse(void)
+{
+    SDL_Mouse *mouse = SDL_GetMouse();
+    mouse->CreateCursor = OHOS_CreateCursor;
+    mouse->CreateSystemCursor = OHOS_CreateSystemCursor;
+    mouse->ShowCursor = OHOS_ShowCursor;
+    mouse->FreeCursor = OHOS_FreeCursor;
+    mouse->SetRelativeMouseMode = OHOS_SetRelativeMouseMode;
+
+    SDL_SetDefaultCursor(OHOS_CreateDefaultCursor());
+
+    last_state = 0;
+}
+
+void OHOS_OnMouse(SDL_OHOSMouseEvent event)
+{
+    SDL_SendMouseMotion(event.timestamp, NULL, SDL_DEFAULT_MOUSE_ID, false, event.x, event.y);
+    if (!event.motion) {
+        SDL_SendMouseButton(event.timestamp, NULL, SDL_DEFAULT_MOUSE_ID, event.button, event.down);
+    }
+}
+
+void OHOS_QuitMouse(void)
+{
+	OHOS_DestroyEmptyCursor();
+}
+
+#endif // SDL_VIDEO_DRIVER_OHOS
