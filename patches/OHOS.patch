diff --git a/src/video/ohos/SDL_ohoswindow.c b/src/video/ohos/SDL_ohoswindow.c
new file mode 100644
index 000000000..f93656d88
--- /dev/null
+++ b/src/video/ohos/SDL_ohoswindow.c
@@ -0,0 +1,159 @@
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_OHOS
+
+#include "../../core/ohos/SDL_ohos.h"
+
+#include "SDL_ohoswindow.h"
+#include "SDL_ohosvideo.h"
+#include "SDL_ohosevents.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+
+#include <EGL/eglplatform.h>
+
+// Currently only one window
+static SDL_Window *OHOS_Window = NULL;
+
+SDL_Window *OHOS_GetWindow() 
+{
+	return OHOS_Window;
+}
+
+bool OHOS_CreateSDLWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+	SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "OHOS_CreateSDLWindow. Width: %d Height: %d", OHOS_SurfaceWidth, OHOS_SurfaceHeight);
+
+    SDL_WindowData *data;
+    bool result = true;
+
+    if (OHOS_Window) {
+        result = SDL_SetError("OHOS only supports one window");
+        goto endfunction;
+    }
+    
+    if (!OHOS_WaitActiveAndLockActivity()) {
+        return false;
+    }
+
+    //TODO
+    // Set orientation
+    //Android_JNI_SetOrientation(window->w, window->h, window->flags & SDL_WINDOW_RESIZABLE, SDL_GetHint(SDL_HINT_ORIENTATIONS));
+
+	// Adjust the window data to match the screen
+    window->x = 0;
+    window->y = 0;
+    window->w = OHOS_SurfaceWidth;
+    window->h = OHOS_SurfaceHeight;
+	// FIXME Set_WindowSize instead ?
+    SDL_SetWindowSafeAreaInsets(window, OHOS_SafeAreaInsets.x, OHOS_SafeAreaInsets.y, 
+		OHOS_SafeAreaInsets.x + OHOS_SafeAreaInsets.w, OHOS_SafeAreaInsets.y + OHOS_SafeAreaInsets.h);
+
+    // One window, it always has focus
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    
+    if (! OHOS_GetNativeWindow())
+    {
+        result = SDL_SetError("Could not fetch native window");
+        goto endfunction;
+    }
+    
+    data = (SDL_WindowData*)SDL_calloc(1, sizeof(SDL_WindowData));
+	if (!data) {
+        result = false;
+        goto endfunction;
+    }
+
+    data->native_window = OHOS_GetNativeWindow();
+    if (!data->native_window) {
+        SDL_free(data);
+        result = SDL_SetError("Could not fetch native window");
+        goto endfunction;
+    }
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        //SDL_LockMutex(g_ohosPageMutex);
+        data->egl_surface = SDL_EGL_CreateSurface(_this, window, (NativeWindowType)data->native_window);
+        if (data->egl_surface == EGL_NO_SURFACE) {
+            //TODO ANativeWindow_release(data->native_window);
+            SDL_free(data);
+            result = false;
+            goto endfunction;
+        }        
+        //	SDL_UnlockMutex(g_ohosPageMutex);
+    }
+#endif 
+    
+    SDL_SetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER, data->native_window);
+    window->internal = data;
+    OHOS_Window = window;
+
+endfunction:
+
+    return result;
+}
+
+void OHOS_SetWindowTitle(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    OHOS_TS_SetWindowTitle(window->title);
+}
+
+SDL_FullscreenResult OHOS_SetWindowFullscreen(SDL_VideoDevice *_this, SDL_Window *window, SDL_VideoDisplay *display, SDL_FullscreenOp fullscreen)
+{
+    OHOS_TS_SetWindowFullscreen(fullscreen == SDL_FULLSCREEN_OP_ENTER);
+	return SDL_FULLSCREEN_SUCCEEDED; // TODO
+}
+
+void OHOS_MinimizeWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    OHOS_TS_MinimizeWindow();
+}
+
+void OHOS_SetWindowResizable(SDL_VideoDevice *_this, SDL_Window *window, bool resizable)
+{
+	OHOS_TS_SetWindowResizable(resizable);
+    // Set orientation
+    //TODO Android_JNI_SetOrientation(window->w, window->h, window->flags & SDL_WINDOW_RESIZABLE, SDL_GetHint(SDL_HINT_ORIENTATIONS));
+}
+
+void OHOS_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (window == OHOS_Window) {
+        OHOS_Window = NULL;
+	}
+    if (_this->windows == window) {
+        _this->windows = _this->windows->next;
+    } else {
+        SDL_Window *curWin = _this->windows;
+        while (curWin != NULL) {
+            if (curWin == window) {
+                if (curWin->next == NULL) {
+                    curWin->prev->next = NULL;
+                } else {
+                    curWin->prev->next = curWin->next;
+                    curWin->next->prev = curWin->prev;
+                }
+                break;
+            }
+            curWin = curWin->next;
+        }
+    }
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    if (window->flags & SDL_WINDOW_OPENGL) {
+        //FIXME SDL_LockMutex(g_ohosPageMutex);
+        if (window->internal->egl_context) {
+            SDL_EGL_DestroyContext(_this, (SDL_GLContext)window->internal->egl_context);
+        }
+        if (window->internal->egl_surface != EGL_NO_SURFACE) {
+            SDL_EGL_DestroySurface(_this, window->internal->egl_surface);
+        }
+        //FIXME SDL_UnlockMutex(g_ohosPageMutex);
+    }
+#endif
+    SDL_free(window->internal);
+}
+
+#endif
