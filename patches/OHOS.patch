+static napi_value sdlKeyEvent(napi_env env, napi_callback_info info)
+{
+    size_t argc = 2;
+    napi_value args[2] = { NULL, NULL };
+    napi_get_cb_info(env, info, &argc, args, NULL, NULL);
+    
+    int keycode, type;
+    napi_get_value_int32(env, args[0], &keycode);
+    napi_get_value_int32(env, args[1], &type);
+    
+    if (type == 0) {
+        OHOS_OnKeyDown((OH_NativeXComponent_KeyCode)keycode);    
+    }
+    else {
+        OHOS_OnKeyUp((OH_NativeXComponent_KeyCode)keycode);
+    }
+    
+    napi_value result;
+    napi_create_int32(env, 0, &result);
+    return result;
+}
