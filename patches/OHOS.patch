+static SDL_PixelFormat CheckPixelFormat(OHNativeWindow* nativeWindow) {
+    int32_t format = 0;
+    
+    // Query the current format of the native window
+    int32_t ret = OH_NativeWindow_NativeWindowHandleOpt(nativeWindow, GET_FORMAT, &format);
+    SDL_PixelFormat pixelFormat = SDL_PIXELFORMAT_UNKNOWN;
+    if (ret == 0) {
+        switch (format) {
+            case NATIVEBUFFER_PIXEL_FMT_RGB_565:
+			pixelFormat = SDL_PIXELFORMAT_RGB565;
+                // This corresponds to your r5g6b5 format
+                break;
+            case NATIVEBUFFER_PIXEL_FMT_RGBX_8888:
+				pixelFormat = SDL_PIXELFORMAT_RGBX8888;
+                break;
+            case NATIVEBUFFER_PIXEL_FMT_RGBA_8888:
+				pixelFormat = SDL_PIXELFORMAT_RGBA8888;
+                break;
+            case NATIVEBUFFER_PIXEL_FMT_BGRX_8888:
+				pixelFormat = SDL_PIXELFORMAT_BGRX8888;
+                break;
+            case NATIVEBUFFER_PIXEL_FMT_BGRA_8888:
+				pixelFormat = SDL_PIXELFORMAT_BGRA8888;
+                break;
+			case NATIVEBUFFER_PIXEL_FMT_RGBA_1010102:
+				pixelFormat = SDL_PIXELFORMAT_ABGR2101010;
+				break;
+			case NATIVEBUFFER_PIXEL_FMT_RGBA16_FLOAT:
+				pixelFormat = SDL_PIXELFORMAT_RGBA64_FLOAT;
+				break;
+            default:
+                SDL_LogError(0, "CheckPixelFormat: Unknown pixel format %d", format);
+                break;
+        }
+    }
+	else 
+	{
+		SDL_LogError(0, "CheckPixelFormat: Failed to get pixel format from native window");
+	}
+	return pixelFormat;
+}
+
+static void FetchDisplayInfo(OHNativeWindow* nativeWindow)
+{
+ 	NativeDisplayManager_ErrorCode err;
+	uint64_t defaultDisplayId = 0;
+	err = OH_NativeDisplayManager_GetDefaultDisplayId(&defaultDisplayId);
+	if (err != DISPLAY_MANAGER_OK) {
+		SDL_LogError(0, "FetchDisplayInfo: Failed to get default display id");
+		return;
+	}
+	NativeDisplayManager_DisplayInfo *displayInfo = NULL;
+    err = OH_NativeDisplayManager_CreateDisplayById(defaultDisplayId, &displayInfo);
+    if (err != DISPLAY_MANAGER_OK) {
+		SDL_LogError(0, "FetchDisplayInfo: Failed to get display info");
+		return;
+    }
+
+	SDL_DisplayOrientation displayNaturalOrientation = SDL_ORIENTATION_PORTRAIT;
+	SDL_DisplayOrientation displayCurrentOrientation = SDL_ORIENTATION_PORTRAIT;
+
+    switch (displayInfo->orientation) {
+    case DISPLAY_MANAGER_PORTRAIT:
+        displayCurrentOrientation = SDL_ORIENTATION_PORTRAIT;
+        break;
+    case DISPLAY_MANAGER_LANDSCAPE:
+        displayCurrentOrientation = SDL_ORIENTATION_LANDSCAPE;
+        break;
+    case DISPLAY_MANAGER_PORTRAIT_INVERTED:
+        displayCurrentOrientation = SDL_ORIENTATION_PORTRAIT_FLIPPED;
+        break;
+    case DISPLAY_MANAGER_LANDSCAPE_INVERTED:
+        displayCurrentOrientation = SDL_ORIENTATION_LANDSCAPE_FLIPPED;
+        break;
+    default:
+        displayCurrentOrientation = SDL_ORIENTATION_UNKNOWN;
+        break;
+    }
+
+	int rotation = 0;
+	switch (displayInfo->rotation) {
+		case DISPLAY_MANAGER_ROTATION_0:
+			rotation = 0;
+			break;
+		case DISPLAY_MANAGER_ROTATION_90:	
+			rotation = 90;
+			break;
+		case DISPLAY_MANAGER_ROTATION_180:
+			rotation = 180;
+			break;
+		case DISPLAY_MANAGER_ROTATION_270:
+			rotation = 270;
+			break;
+	}
+
+	if (displayNaturalOrientation == SDL_ORIENTATION_LANDSCAPE) {
+        rotation += 90; // FIXME Correct?
+    }
+
+    switch (rotation % 360) {
+    case 0:
+        displayNaturalOrientation = SDL_ORIENTATION_PORTRAIT;
+        break;
+    case 90:
+        displayNaturalOrientation = SDL_ORIENTATION_LANDSCAPE;
+        break;
+    case 180:
+        displayNaturalOrientation = SDL_ORIENTATION_PORTRAIT_FLIPPED;
+        break;
+    case 270:
+        displayNaturalOrientation = SDL_ORIENTATION_LANDSCAPE_FLIPPED;
+        break;
+    default:
+        displayNaturalOrientation = SDL_ORIENTATION_UNKNOWN;
+        break;
+    }
+
+	NativeDisplayManager_Rect *availableArea = NULL;
+	err = OH_NativeDisplayManager_CreateAvailableArea(defaultDisplayId, &availableArea);
+    if (err != DISPLAY_MANAGER_OK) {
+		SDL_LogError(0, "OH_NativeDisplayManager_CreateAvailableArea failed");
+		return;
+    }
+
+	SDL_Rect safeArea;
+	safeArea.x = availableArea->left;
+	safeArea.y = availableArea->top;
+	safeArea.w = availableArea->width;
+	safeArea.h = availableArea->height;
+	OH_NativeDisplayManager_DestroyAvailableArea(availableArea);
+    
+    SDL_PixelFormat pixelFormat = CheckPixelFormat(nativeWindow);
+
+	OHOS_SetDisplayInfo(displayInfo->width, displayInfo->height, displayInfo->densityPixels, displayInfo->refreshRate,
+		displayNaturalOrientation, displayCurrentOrientation, &safeArea, pixelFormat);
+
+	OH_NativeDisplayManager_DestroyDisplay(displayInfo);
+
+//TODO Try ? OH_NativeDisplayManager_RegisterDisplayChangeListener(
+    //OH_NativeDisplayManager_DisplayChangeCallback displayChangeCallback, uint32_t *listenerIndex
+}
+
+static void onSurfaceCreatedCB(OH_NativeXComponent *component, void *nativeWindow)
+{
+	g_ohosNativeComponent = component;
+    g_ohosNativeWindow = (OHNativeWindow *)nativeWindow;
+
+    FetchDisplayInfo((OHNativeWindow*) nativeWindow);
+
+    uint64_t surfaceWidth;
+    uint64_t surfaceHeight;
+    double offsetX;
+    double offsetY;
+    OH_NativeXComponent_GetXComponentSize(component, nativeWindow, &surfaceWidth, &surfaceHeight);
+    OH_NativeXComponent_GetXComponentOffset(component, nativeWindow, &offsetX, &offsetY);
+	OHOS_SetSurfaceInfo(surfaceWidth, surfaceHeight);
+
+    napiCallbackData *data = (napiCallbackData *)SDL_malloc(sizeof(napiCallbackData));
+    data->func = "onMainLaunch";
+    data->argCount = 0;
+
+    napi_call_threadsafe_function(napiEnv.func, data, napi_tsfn_nonblocking);
+}
+
+static void onSurfaceChangedCB(OH_NativeXComponent *component, void *nativeWindow)
+{
+	g_ohosNativeComponent = component;
+    g_ohosNativeWindow = (OHNativeWindow *)nativeWindow;
+    
+    // Detect orientation change
+    FetchDisplayInfo((OHNativeWindow*) nativeWindow);
+    
+    uint64_t width;
+    uint64_t height;
+    double offsetX;
+    double offsetY;
+    int ret = OH_NativeXComponent_GetXComponentSize(component, nativeWindow, &width, &height);
+	if (ret == OH_NATIVEXCOMPONENT_RESULT_SUCCESS) {
+		OH_NativeXComponent_GetXComponentOffset(component, nativeWindow, &offsetX, &offsetY);
+		OHOS_SetSurfaceInfo(width, height);
+
+		SDL_VideoDevice * videoDevice = SDL_GetVideoDevice();
+		if (videoDevice && videoDevice->windows) {
+			SDL_Window *w = videoDevice->windows;
+			SDL_SetWindowSize(w, width, height);
+			SDL_SetWindowPosition(w, (int)offsetX, (int)offsetY);
+            // TODO undeclared ?
+			SDL_SendWindowEvent(w, SDL_EVENT_WINDOW_RESIZED, width, height);
+			// TODO The safe area shold not change, it is per display, not per window
+			//SDL_SetWindowSafeAreaInsets(w, )
+		}
+	} else {
+        SDL_LogError(0, "OnSurfaceChangedCB failed");
+    }	
+}
+
+static void onSurfaceDestroyedCB(OH_NativeXComponent *component, void *nativeWindow)
+{
+    SDL_assert(g_ohosNativeComponent == component);
+    SDL_assert(g_ohosNativeWindow == nativeWindow);
+	g_ohosNativeComponent = NULL;
+    g_ohosNativeWindow = NULL;
+    
+    SDL_VideoDevice *_this = SDL_GetVideoDevice();
+    if (_this && _this->windows)
+    {
+        SDL_Window *win = _this->windows;
+        while (win != NULL) {
+    #ifdef SDL_VIDEO_OPENGL_EGL
+            if (win->flags & SDL_WINDOW_OPENGL) {
+                if (win->internal->egl_context) {
+                    SDL_EGL_DestroyContext(_this, (SDL_GLContext)win->internal->egl_context);
+                }
+                if (win->internal->egl_surface) {
+                    SDL_EGL_DestroySurface(_this, win->internal->egl_surface);
+                }
+            }
+    #endif
+            win = win->next;
+        }
+    }
+}
+
+static void onKeyEvent(OH_NativeXComponent *component, void *window)
+{
+    OH_NativeXComponent_KeyEvent *keyEvent = NULL;
+    if (OH_NativeXComponent_GetKeyEvent(component, &keyEvent) >= 0) {
+        OH_NativeXComponent_KeyAction action;
+        OH_NativeXComponent_KeyCode code;
+        OH_NativeXComponent_EventSourceType sourceType;
+
+        OH_NativeXComponent_GetKeyEventAction(keyEvent, &action);
+        OH_NativeXComponent_GetKeyEventCode(keyEvent, &code);
+        OH_NativeXComponent_GetKeyEventSourceType(keyEvent, &sourceType);
+
+        if (sourceType == OH_NATIVEXCOMPONENT_SOURCE_TYPE_KEYBOARD) {
+            if (OH_NATIVEXCOMPONENT_KEY_ACTION_DOWN == action) {
+                OHOS_OnKeyDown(code);
+            } else if (OH_NATIVEXCOMPONENT_KEY_ACTION_UP == action) {
+                OHOS_OnKeyUp(code);
+            }
+        }
+    }
+}
+
+static void onNativeTouch(OH_NativeXComponent *component, void *window)
+{
+    OH_NativeXComponent_TouchEvent touchEvent;
+    //OH_NativeXComponent_TouchPointToolType toolType = OH_NATIVEXCOMPONENT_TOOL_TYPE_UNKNOWN;
+    uint64_t windowWidth = 0;
+    uint64_t windowHeight = 0;
+    OHOS_LockPage();
+    OH_NativeXComponent_GetXComponentSize(component, window, &windowWidth, &windowHeight);
+    OH_NativeXComponent_GetTouchEvent(component, window, &touchEvent);
+    //OH_NativeXComponent_GetTouchPointToolType(component, 0, &toolType);
+    OHOS_UnlockPage();
+
+    SDL_VideoDevice * videoDevice = SDL_GetVideoDevice();
+    SDL_Window *sdlWindow = videoDevice->windows;
+ 
+    for (int i = 0; i < touchEvent.numPoints; i++) {
+        SDL_OHOSTouchEvent e;
+        e.timestamp = touchEvent.timeStamp;
+        // skip assertions
+        e.deviceId = touchEvent.deviceId + 1;
+        e.fingerId = touchEvent.touchPoints[i].id + 1;
+        e.area = touchEvent.touchPoints[i].size;
+        e.x = touchEvent.touchPoints[i].x / (float)windowWidth;
+        e.y = touchEvent.touchPoints[i].y / (float)windowHeight;
+        e.p = touchEvent.touchPoints[i].force;
+
+        switch (touchEvent.touchPoints[i].type) {
+        case OH_NATIVEXCOMPONENT_DOWN:
+            e.type = SDL_EVENT_FINGER_DOWN;
+            break;
+        case OH_NATIVEXCOMPONENT_MOVE:
+            e.type = SDL_EVENT_FINGER_MOTION;
+            break;
+        case OH_NATIVEXCOMPONENT_UP:
+            e.type = SDL_EVENT_FINGER_UP;
+            break;
+        case OH_NATIVEXCOMPONENT_CANCEL:
+        case OH_NATIVEXCOMPONENT_UNKNOWN:
+            e.type = SDL_EVENT_FINGER_CANCELED;
+            break;
+        }
+        
+        OHOS_OnTouch(e, sdlWindow);
+    }
+    
+}
+// TODO mouse data
+static void onNativeMouse(OH_NativeXComponent *component, void *window) {
+    OH_NativeXComponent_MouseEvent event;
+    OHOS_LockPage();
+    OH_NativeXComponent_GetMouseEvent(component, window, &event);
+    if (event.button == OH_NATIVEXCOMPONENT_NONE_BUTTON || event.action == OH_NATIVEXCOMPONENT_MOUSE_NONE) {
+        return;
+    }
+    SDL_OHOSMouseEvent e;
+    e.x = event.x;
+    e.y = event.y;
+    e.timestamp = event.timestamp;
+    switch (event.button)
+    {
+    case OH_NATIVEXCOMPONENT_LEFT_BUTTON:
+        e.button = SDL_BUTTON_LEFT;
+        break;
+    case OH_NATIVEXCOMPONENT_RIGHT_BUTTON:
+        e.button = SDL_BUTTON_RIGHT;
+        break;
+    case OH_NATIVEXCOMPONENT_MIDDLE_BUTTON:
+        e.button = SDL_BUTTON_MIDDLE;
+        break;
+    case OH_NATIVEXCOMPONENT_BACK_BUTTON:
+        e.button = SDL_BUTTON_X1;
+        break;
+    case OH_NATIVEXCOMPONENT_FORWARD_BUTTON:
+        e.button = SDL_BUTTON_X2;
+        break;
+    case OH_NATIVEXCOMPONENT_NONE_BUTTON:
+        break;
+    }
+
+    if (event.action == OH_NATIVEXCOMPONENT_MOUSE_MOVE) {
+        e.motion = true;    
+    }
+    else {
+        e.down = event.action == OH_NATIVEXCOMPONENT_MOUSE_PRESS;
+    }
+    OHOS_OnMouse(e);
+    
+    OHOS_UnlockPage();
+}
