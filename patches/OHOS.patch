+static bool OHOS_VideoInit(SDL_VideoDevice *_this)
+{
+	SDL_VideoData *videodata = _this->internal;
+	SDL_DisplayID displayID;
+    SDL_VideoDisplay *display;
+    SDL_DisplayMode mode;
