+            return index;
+        }
+    }
+    return -1;
+}
+
+static void RemoveLifecycleEvent(int index)
+{
+    if (index < OHOS_NumLifecycleEvents - 1) {
+        SDL_memmove(&OHOS_LifecycleEvents[index], &OHOS_LifecycleEvents[index+1], (OHOS_NumLifecycleEvents - index - 1) * sizeof(OHOS_LifecycleEvents[index]));
+    }
+    --OHOS_NumLifecycleEvents;
+}
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+static void ohos_egl_context_restore(SDL_Window *window)
+{
+    SDL_WindowData *data = window->internal;
+    if (data->egl_context) {
+		SDL_assert(data->backup_done);
+        SDL_GL_MakeCurrent(window, NULL);
+        if (!SDL_GL_MakeCurrent(window, (SDL_GLContext)data->egl_context)) {
+            // The context is no longer valid, create a new one
+            data->egl_context = (EGLContext)SDL_GL_CreateContext(window);
+            SDL_GL_MakeCurrent(window, (SDL_GLContext)data->egl_context);
+            SDL_Event event;
+            SDL_zero(event);
+            event.type = SDL_EVENT_RENDER_DEVICE_RESET;
+            event.render.windowID = SDL_GetWindowID(window);
+            SDL_PushEvent(&event);
+        }
+        data->backup_done = false;
+
+        if (data->has_swap_interval) {
+            SDL_GL_SetSwapInterval(data->swap_interval);
+        }
+
+    }
+}
+
+static void ohos_egl_context_backup(SDL_Window *window)
+{
+	int interval = 0;
+	// Keep a copy of the EGL Context so we can try to restore it when we resume
+	SDL_WindowData *data = window->internal;
+	data->egl_context = SDL_GL_GetCurrentContext();
+
+	// Save/Restore the swap interval / vsync
+	if (SDL_GL_GetSwapInterval(&interval)) {
+		data->has_swap_interval = 1;
+		data->swap_interval = interval;
+	}
+
+	// We need to do this so the EGLSurface can be freed
+	SDL_GL_MakeCurrent(window, NULL);
+	data->backup_done = true;
+}
+#endif // SDL_VIDEO_OPENGL_EGL
+
+static void OHOS_PauseAudio(void)
+{
+    OPENSLES_PauseDevices();
+    //TODO AAUDIO_PauseDevices();
+    OHOS_PausedAudio = true;
+}
+
+static void OHOS_ResumeAudio(void)
+{
+    if (OHOS_PausedAudio) {
+        OPENSLES_ResumeDevices();
+        //TODO AAUDIO_ResumeDevices();
+        OHOS_PausedAudio = false;
+    }
+}
+
+static void OHOS_OnPause(void)
+{
+    SDL_OnApplicationWillEnterBackground();
+    SDL_OnApplicationDidEnterBackground();
+
+    /* The semantics are that as soon as the enter background event
+     * has been queued, the app will block. The application should
+     * do any life cycle handling in an event filter while the event
+     * was being queued.
+     */
+#ifdef SDL_VIDEO_OPENGL_EGL
+    SDL_Window * window = OHOS_GetWindow();
+    if (window && !window->external_graphics_context) {
+        OHOS_LockActivityMutex();
+        ohos_egl_context_backup(window);
+        OHOS_UnlockActivityMutex();
+    }
+#endif
+
+    if (OHOS_BlockOnPause) {
+        // We're blocking, also pause audio
+        OHOS_PauseAudio();
+    }
+
+    OHOS_Paused = true;
+}
+
+static void OHOS_OnResume(void)
+{
+    OHOS_Paused = false;
+
+    SDL_OnApplicationWillEnterForeground();
+
+    OHOS_ResumeAudio();
+
+#ifdef SDL_VIDEO_OPENGL_EGL
+    // Restore the GL Context from here, as this operation is thread dependent
+    SDL_Window * window = OHOS_GetWindow();
+    if (window && !window->external_graphics_context && !SDL_HasEvent(SDL_EVENT_QUIT)) {
+        OHOS_LockActivityMutex();
+        ohos_egl_context_restore(window);
+        OHOS_UnlockActivityMutex();
+    }
+#endif
+
+    SDL_OnApplicationDidEnterForeground();
+}
+
+static void OHOS_OnLowMemory(void)
+{
+    SDL_SendAppEvent(SDL_EVENT_LOW_MEMORY);
+}
+
+static void OHOS_OnDestroy(void)
+{
+    // Make sure we unblock any audio processing before we quit
+    OHOS_ResumeAudio();
+
+    /* Discard previous events. The user should have handled state storage
+     * in SDL_EVENT_WILL_ENTER_BACKGROUND. After nativeSendQuit() is called, no
+     * events other than SDL_EVENT_QUIT and SDL_EVENT_TERMINATING should fire */
+    SDL_FlushEvents(SDL_EVENT_FIRST, SDL_EVENT_LAST);
+    SDL_SendQuit();
+    SDL_SendAppEvent(SDL_EVENT_TERMINATING);
+
+    OHOS_Destroyed = true;
+}
+
+static void OHOS_HandleLifecycleEvent(SDL_OHOSLifecycleEvent event)
+{
+	OHOS_CheckSDLThread();
+
+	switch (event) {
+    case SDL_OHOS_LIFECYCLE_WAKE:
+        // Nothing to do, just return
+        break;
+    case SDL_OHOS_LIFECYCLE_PAUSE:
+        OHOS_OnPause();
+        break;
+    case SDL_OHOS_LIFECYCLE_RESUME:
+        OHOS_OnResume();
+        break;
+    case SDL_OHOS_LIFECYCLE_LOWMEMORY:
+        OHOS_OnLowMemory();
+        break;
+    case SDL_OHOS_LIFECYCLE_DESTROY:
+        OHOS_OnDestroy();
+        break;
+    default:
+        break;
+    }
+}
+
+static Sint64 GetLifecycleEventTimeout(bool paused, Sint64 timeoutNS)
+{
+    if (OHOS_Paused) {
+        if (OHOS_BlockOnPause) {
+            timeoutNS = -1;
+        } else if (timeoutNS == 0) {
+            timeoutNS = SDL_MS_TO_NS(100);
+        }
+    }
+    return timeoutNS;
+}
+
+static bool OHOS_WaitLifecycleEvent(SDL_OHOSLifecycleEvent *event, Sint64 timeoutNS)
+{
+    bool got_event = false;
+
+    while (!got_event && SDL_WaitSemaphoreTimeoutNS(OHOS_LifecycleEventSem, timeoutNS)) {
+        SDL_LockMutex(OHOS_LifecycleMutex);
+        {
+            if (OHOS_NumLifecycleEvents > 0) {
+                *event = OHOS_LifecycleEvents[0];
+                RemoveLifecycleEvent(0);
+                got_event = true;
+            }
+        }
+        SDL_UnlockMutex(OHOS_LifecycleMutex);
+    }
+    return got_event;
+}
+
+void OHOS_InitEvents(void)
+{
+    if (!OHOS_EventsInitialized) {
+        OHOS_BlockOnPause = SDL_GetHintBoolean(SDL_HINT_ANDROID_BLOCK_ON_PAUSE, true);
+        OHOS_Paused = false;
+        OHOS_Destroyed = false;
+        OHOS_EventsInitialized = true;
+
+		OHOS_LifecycleMutex = SDL_CreateMutex();
+		if (!OHOS_LifecycleMutex) {
+			SDL_LogError(0, "failed to create OHOS_LifecycleMutex mutex");
+		}
+
+		OHOS_LifecycleEventSem = SDL_CreateSemaphore(0);
+		if (!OHOS_LifecycleEventSem) {
+			SDL_LogError(0, "failed to create OHOS_LifecycleEventSem semaphore");
+		}
+	
+	}
+}
+
+void OHOS_SendLifecycleEvent(SDL_OHOSLifecycleEvent event)
+{
+    SDL_LockMutex(OHOS_LifecycleMutex);
+	int index;
+	bool add_event = true;
+
+	switch (event) {
+	case SDL_OHOS_LIFECYCLE_WAKE:
+		// We don't need more than one wake queued
+		index = FindLifecycleEvent(SDL_OHOS_LIFECYCLE_WAKE);
+		if (index >= 0) {
+			add_event = false;
+		}
+		break;
+	case SDL_OHOS_LIFECYCLE_PAUSE:
+		// If we have a resume queued, just stay in the paused state
+		index = FindLifecycleEvent(SDL_OHOS_LIFECYCLE_RESUME);
+		if (index >= 0) {
+			RemoveLifecycleEvent(index);
+			add_event = false;
+		}
+		break;
+	case SDL_OHOS_LIFECYCLE_RESUME:
+		// If we have a pause queued, just stay in the resumed state
+		index = FindLifecycleEvent(SDL_OHOS_LIFECYCLE_PAUSE);
+		if (index >= 0) {
+			RemoveLifecycleEvent(index);
+			add_event = false;
+		}
+		break;
+	case SDL_OHOS_LIFECYCLE_LOWMEMORY:
+		// We don't need more than one low memory event queued
+		index = FindLifecycleEvent(SDL_OHOS_LIFECYCLE_LOWMEMORY);
+		if (index >= 0) {
+			add_event = false;
+		}
+		break;
+	case SDL_OHOS_LIFECYCLE_DESTROY:
+		// Remove all other events, we're done!
+		while (OHOS_NumLifecycleEvents > 0) {
+			RemoveLifecycleEvent(0);
+		}
+		break;
+	default:
+		SDL_assert(!"Sending unexpected lifecycle event");
+		add_event = false;
+		break;
+	}
+
+	if (add_event) {
+		SDL_assert(OHOS_NumLifecycleEvents < SDL_arraysize(OHOS_LifecycleEvents));
+		OHOS_LifecycleEvents[OHOS_NumLifecycleEvents++] = event;
+		SDL_SignalSemaphore(OHOS_LifecycleEventSem);
+	}
+    SDL_UnlockMutex(OHOS_LifecycleMutex);
+}
+
+void OHOS_PumpEvents(Sint64 timeoutNS)
+{
+	OHOS_CheckSDLThread();
+
+    SDL_OHOSLifecycleEvent event;
+    bool paused = OHOS_Paused;
+
+    while (!OHOS_Destroyed &&
+           OHOS_WaitLifecycleEvent(&event, GetLifecycleEventTimeout(paused, timeoutNS))) {
+        OHOS_HandleLifecycleEvent(event);
+
+        switch (event) {
+        case SDL_OHOS_LIFECYCLE_WAKE:
+            // Finish handling events quickly if we're not paused
+            timeoutNS = 0;
+            break;
+        case SDL_OHOS_LIFECYCLE_PAUSE:
+            // Finish handling events at the current timeout and return to process events one more time before blocking.
+            break;
+        case SDL_OHOS_LIFECYCLE_RESUME:
+            // Finish handling events at the resume state timeout
+            paused = false;
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+bool OHOS_WaitActiveAndLockActivity(void)
+{
+    /* Make sure we have pumped all events so that OHOS_Paused state is correct */
+    SDL_OHOSLifecycleEvent event;
+    while (!OHOS_Destroyed && OHOS_WaitLifecycleEvent(&event, 0)) {
+        OHOS_HandleLifecycleEvent(event);
+    }
+
+    while (OHOS_Paused && !OHOS_Destroyed) {
+        OHOS_PumpEvents(-1);
+    }
+
+    if (OHOS_Destroyed) {
+        SDL_SetError("OHOS activity has been destroyed");
+        return false;
+    }
+
+    OHOS_LockActivityMutex();
+    return true;
+}
+
+void OHOS_QuitEvents(void)
+{
+    OHOS_EventsInitialized = false;
+}
+
+#endif // SDL_PLATFORM_OHOS
