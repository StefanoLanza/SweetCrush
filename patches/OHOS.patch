+typedef struct sdlThreadData_ {
+    char* libname;
+    char* func;
+} sdlThreadData;
+
+static int sdlLaunchMainInternal(void* reserved)
+{
+    int status = -1;
+    sdlThreadData *data = (sdlThreadData*)reserved;
+    void *library_handle = dlopen(data->libname, RTLD_GLOBAL);
+    if (library_handle) {
+        SDL_main_func SDL_main = (SDL_main_func)dlsym(library_handle, data->func);
+        if (SDL_main) {
+            // TODO Get args
+            int argc = 0;
+            char **argv = NULL;
+            status = SDL_RunApp(argc, argv, SDL_main, NULL);
+        }
+        else {
+            SDL_LogError(0, "sdlLaunchMainInternal(): Couldn't find function %s in library %s", data->func, data->libname);
+        }
+        dlclose(library_handle);
+    }
+    else {
+        SDL_LogError(0, "sdlLaunchMainInternal(): Couldn't load library %s", data->libname);
+    }
+    SDL_free(reserved);
+
+	SDL_LogDebug(0, "SDL thread complete");
+	// notify TS the thread is over
+	napiCallbackData *napi_data = (napiCallbackData *)SDL_malloc(sizeof *napi_data);
+    napi_data->func = "onSDLThreadComplete";
+    napi_data->argCount = 0;
+    napi_call_threadsafe_function(napiEnv.func, napi_data, napi_tsfn_nonblocking);
+ 
+    return status;
+}
+
+static napi_value sdlLaunchMain(napi_env env, napi_callback_info info)
+{
+    size_t argc = 2;
+    napi_value args[2] = { NULL, NULL };
+    napi_get_cb_info(env, info, &argc, args, NULL, NULL);
+
+    size_t libstringSize = 0;
+    napi_get_value_string_utf8(env, args[0], NULL, 0, &libstringSize);
+    char *libname = (char*)SDL_malloc(libstringSize + 1);
+    napi_get_value_string_utf8(env, args[0], libname, libstringSize + 1, &libstringSize);
+
+    size_t fstringSize = 0;
+    napi_get_value_string_utf8(env, args[1], NULL, 0, &fstringSize);
+    char *fname = (char*)SDL_malloc(fstringSize + 1);
+    napi_get_value_string_utf8(env, args[1], fname, fstringSize + 1, &fstringSize);
+
+    // TODO get args
+    // Store in entry, pass to sdlLaunchMainInternal
+
+    sdlThreadData *data = (sdlThreadData*)SDL_malloc(sizeof *data);
+    data->func = fname;
+    data->libname = libname;
+    mainThread = SDL_CreateThread(sdlLaunchMainInternal, "SDL Thread", data);
+    SDL_SetMainReady();
+
+    napi_value result;
+    napi_create_int32(env, 0, &result);
+    return result;
+}
