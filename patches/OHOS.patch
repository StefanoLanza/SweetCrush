+#include "SDL_ohostouch.h"
+
+#ifdef SDL_PLATFORM_OHOS
+
+#include "../../events/SDL_touch_c.h"
+#include "SDL_internal.h"
+
+void OHOS_InitTouch(void)
+{
+	// TODO
+}
+
+void OHOS_OnTouch(SDL_OHOSTouchEvent event, SDL_Window* window)
+{
+    if (SDL_AddTouch(event.deviceId, SDL_TOUCH_DEVICE_DIRECT, "") < 0) {
+        SDL_Log(0, "OHOS_OnTouch: cannot add touch");
+        return;
+    }
+
+    switch (event.type) {
+    case SDL_EVENT_FINGER_DOWN:
+    {
+        SDL_SendTouch(event.timestamp, event.deviceId, event.fingerId, window, SDL_EVENT_FINGER_DOWN, event.x, event.y, event.p);
+        break;
+    }
+    case SDL_EVENT_FINGER_MOTION:
+    {
+        SDL_SendTouchMotion(event.timestamp, event.deviceId, event.fingerId, window, event.x, event.y, event.p);
+        break;
+    }
+    case SDL_EVENT_FINGER_UP:
+    {
+        SDL_SendTouch(event.timestamp, event.deviceId, event.fingerId, window, SDL_EVENT_FINGER_UP, event.x, event.y, event.p);
+        break;
+    }
+    case SDL_EVENT_FINGER_CANCELED:
+    {
+        SDL_SendTouch(event.timestamp, event.deviceId, event.fingerId, window, SDL_EVENT_FINGER_CANCELED, event.x, event.y, event.p);
+        break;
+    }
+    }
+}
+
+void OHOS_QuitTouch() {
+	// todo
+}
+
+#endif /* SDL_PLATFORM_OHOS */
