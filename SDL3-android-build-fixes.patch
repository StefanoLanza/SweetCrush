From efa8e93478f59c5cf38ee55ca9e2cbe6bcbf8ff3 Mon Sep 17 00:00:00 2001
From: Stefano Lanza <steflanz@gmail.com>
Date: Sun, 21 Dec 2025 20:33:25 +0100
Subject: [PATCH] Local build fixes

---
 Android.mk                                 |  1 -
 src/filesystem/android/SDL_sysfilesystem.c |  7 +++
 src/filesystem/android/SDL_sysfsops.c      | 62 ++++++++++++++++++++++
 3 files changed, 69 insertions(+), 1 deletion(-)
 create mode 100644 src/filesystem/android/SDL_sysfsops.c

diff --git a/Android.mk b/Android.mk
index f4600bfa2..028573a04 100644
--- a/Android.mk
+++ b/Android.mk
@@ -64,7 +64,6 @@ LOCAL_SRC_FILES := \
 	$(wildcard $(LOCAL_PATH)/src/process/dummy/*.c) \
 	$(wildcard $(LOCAL_PATH)/src/filesystem/*.c) \
 	$(wildcard $(LOCAL_PATH)/src/filesystem/android/*.c) \
-	$(wildcard $(LOCAL_PATH)/src/filesystem/posix/*.c) \
 	$(wildcard $(LOCAL_PATH)/src/sensor/*.c) \
 	$(wildcard $(LOCAL_PATH)/src/sensor/android/*.c) \
 	$(wildcard $(LOCAL_PATH)/src/sensor/dummy/*.c) \
diff --git a/src/filesystem/android/SDL_sysfilesystem.c b/src/filesystem/android/SDL_sysfilesystem.c
index 69577fbd4..2b027813a 100644
--- a/src/filesystem/android/SDL_sysfilesystem.c
+++ b/src/filesystem/android/SDL_sysfilesystem.c
@@ -57,4 +57,11 @@ char *SDL_SYS_GetUserFolder(SDL_Folder folder)
     return NULL;
 }
 
+// TODO
+char *SDL_SYS_GetCurrentDirectory(void)
+{
+    SDL_Unsupported();
+    return NULL;
+}
+
 #endif // SDL_FILESYSTEM_ANDROID
diff --git a/src/filesystem/android/SDL_sysfsops.c b/src/filesystem/android/SDL_sysfsops.c
new file mode 100644
index 000000000..1bcc5c8c8
